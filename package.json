{
  "name": "scootsense",
  "version": "1.0.0",
  "description": "Turn a kick scooter into a moving sensor for potholes, air pollution and litter: Raspberry Pi unit, web app, Gemini, Tiger Data and Solana.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js --reset",
    "solana:setup": "node scripts/solana-setup.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.99.0",
    "@vercel/functions": "^3.10.1",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1"
  },
  "overrides": {
    "rpc-websockets": "9.3.2"
  }
}
