{
  "name": "scootsense",
  "version": "1.0.0",
  "description": "Turn a kick scooter into a mobile road-condition sensor. ESP32 + MPU6050 + GPS, on-device feature extraction, trainable classifier and Gemini-powered city insights.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js --reset"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1"
  }
}
