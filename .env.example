# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id. The alias always tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
PORT=3000
# Optional: shared secret the ESP32 must send when streaming over Wi-Fi
INGEST_TOKEN=

# ---- Accounts ----
# Tiger Data (Tiger Cloud) connection string: console.cloud.timescale.com -> your service -> Connect
DATABASE_URL=
# Google Sign-In: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Add http://localhost:3000 and https://scootsense.vercel.app as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Long random string used to sign session cookies
AUTH_SECRET=
